{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "url": [
        "http://localhost/herramientas/eventos-ics/",
        "http://localhost/herramientas/tiempo-lectura-voz-alta/",
        "http://localhost/clubes-de-lectura/preparar-sesion/",
        "http://localhost/herramientas/entrevista-familiar/",
        "http://localhost/recursos/ficha-historia-objeto-heredado/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "categories:best-practices": ["warn", { "minScore": 0.95, "aggregationMethod": "pessimistic" }],
            "categories:seo": "off",
            "is-crawlable": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "document-title": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "meta-description": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "http-status-code": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "link-text": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "crawlable-anchors": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "canonical": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3500, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "pessimistic" }],
            "total-blocking-time": ["error", { "maxNumericValue": 400, "aggregationMethod": "median" }]
          }
        }
      ]
    }
  }
}

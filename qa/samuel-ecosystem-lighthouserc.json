{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "url": [
        "http://localhost/libros/samuel-entre-mundos/",
        "http://localhost/fragmento/",
        "http://localhost/universo/noveris/",
        "http://localhost/clubes-de-lectura/samuel-entre-mundos/",
        "http://localhost/clubes-de-lectura/samuel-entre-mundos/guia-imprimible/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.98,
            "aggregationMethod": "median"
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 3500,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "pessimistic"
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 400,
            "aggregationMethod": "median"
          }
        ]
      }
    }
  }
}

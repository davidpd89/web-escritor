# RFC 5545 folds lines at 75 octets with CRLF; a fold may end right after a space, which
# git diff --check would reject as trailing whitespace in the intake (refresh-reading-catalogue).
*.ics -text -whitespace
# Pagefind vendor bundles are generated by the pinned pagefind package; their
# minified template literals carry trailing whitespace that git diff --check
# must not reject (it broke the intake run 41974714609 after the 1.6.0 bump).
pagefind/** -whitespace

!/humans.txt
!/index.html
!/llms-full.txt
!/llms.txt
!/manifest.json
!/offline.html
!/premios.html
!/prensa.html
!/privacidad.html
!/robots.txt
!/samuel-entre-mundos.html
!/script.js
!/service-worker.js
!/sitemap.xml
!/styles.css

!/accesibilidad/

# Claude Code: permisos, rutas y configuración específica de cada máquina.
# La configuración compartida debe vivir en ficheros deliberadamente versionados;
# settings.local.json nunca debe entrar al repositorio.
.claude/settings.local.json

# Large lossless source masters for the visual-asset pipeline (SOURCE -> MASTER
# -> WEB OPTIMIZED per WEB DAVID PORTO nuevas ideas/26_.../section 16). Only
# the final web-optimized outputs (assets/*.webp) are tracked; the PNG
# sources stay local so regeneration is possible without repo bloat.
assets/manecillas/source/*.png
assets/*/source/*.png

# Build output of scripts/build-public-dist.py — generated, never tracked.
.preview-dist/
.preview-dist-manifest.json
scripts/brevo/.snapshot-local.json
dist/
lh.html

# Ephemeral copy scripts/build-pagefind-index.py feeds to the pagefind CLI --
# deleted again as soon as the build finishes. pagefind/ itself (the actual
# search index) IS committed: `import('/pagefind/pagefind.js')` needs to
# resolve on a repo that ships as static files with no build step.
.pagefind-src/

# QA evidence written by the browser suites and uploaded by CI — generated,
# never tracked.
artifacts/
qa-artifacts/
.lighthouseci/

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "david-porto-assistant",
  "main": "cloudflare-worker-assistant.js",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "ASSISTANT_QUOTA_DB",
      "database_name": "david-porto-assistant-quota",
      "database_id": "02dd6e93-7bf2-421d-abdd-fd16f73508d7"
    }
  ],
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": {
    "ASSISTANT_ENABLED": "false",
    "ASSISTANT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "ASSISTANT_MATCH_THRESHOLD": "0.42",
    "ASSISTANT_REQUIRE_METADATA_FILTER": "false",
    "ASSISTANT_DAILY_SESSION_LIMIT": "5",
    "ASSISTANT_DAILY_GLOBAL_LIMIT": "50",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEdBsnHlu76Hm75M",
    "TURNSTILE_HOSTNAMES": "davidportodiaz.com",
    "WORKERS_AI_DAILY_CAP": "500",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "GROQ_DAILY_CAP": "200",
    "OPENROUTER_MODEL": "meta-llama/llama-3.3-70b-instruct:free",
    "OPENROUTER_DAILY_CAP": "50"
  }
}

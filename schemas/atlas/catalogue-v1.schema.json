{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davidportodiaz.com/schemas/atlas/catalogue-v1.schema.json",
  "title": "Atlas literario mundial — contrato editorial interno v1",
  "description": "NO es un dataset publicado. La exportación pública excluye candidatos y notas internas; validar además claves y evidencias mediante reglas cruzadas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "destinations",
    "places",
    "works",
    "authors",
    "adaptations",
    "sources",
    "relationships",
    "images",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "destinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "adaptations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adaptation"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "status": {
          "enum": [
            "candidate",
            "researching",
            "reviewed",
            "approved",
            "rejected",
            "retired"
          ]
        },
        "verified_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "verified_at"
        ]
      }
    },
    "destination": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "slug",
            "name",
            "country_iso2"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "country_iso2": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "admin1": {
              "type": "string"
            },
            "geonames_id": {
              "type": "integer",
              "minimum": 1
            },
            "wikidata_qid": {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            },
            "name_es": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "parent_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "summary_original": {
              "type": "string",
              "description": "Texto editorial propio; solo saldrá página indexable cuando sea sustantivo."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "place": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "slug",
            "name",
            "destination_id",
            "place_type",
            "geo_precision"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "destination_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "place_type": {
              "enum": [
                "bookshop",
                "library",
                "museum",
                "writer_house_museum",
                "booktown",
                "monument",
                "literary_plaque",
                "street",
                "square",
                "cafe",
                "film_location",
                "landscape",
                "festival",
                "other",
                "historic_site"
              ]
            },
            "geo_precision": {
              "enum": [
                "point",
                "building",
                "area",
                "city",
                "unlocated"
              ]
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "osm_type": {
              "enum": [
                "node",
                "way",
                "relation"
              ]
            },
            "osm_id": {
              "type": "integer",
              "minimum": 1
            },
            "wikidata_qid": {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            },
            "public_address": {
              "type": "string"
            },
            "official_url": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "visit_status": {
              "enum": [
                "visit_inside",
                "outside",
                "reservation",
                "closed",
                "unknown"
              ]
            },
            "summary_original": {
              "type": "string"
            },
            "image_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,79}$"
              },
              "uniqueItems": true
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,79}$"
              },
              "uniqueItems": true
            },
            "overture_gers_id": {
              "type": "string",
              "minLength": 10,
              "maxLength": 128,
              "description": "ID externo GERS de Overture Places, separado de clave editorial"
            },
            "overture_release": {
              "type": "string",
              "minLength": 6,
              "maxLength": 32,
              "description": "Release precisa del proveedor (p.ej. 2026-09-23.1)"
            },
            "overture_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Calidad del registro proveedor NO certeza literaria"
            }
          },
          "dependentRequired": {
            "latitude": [
              "longitude"
            ],
            "longitude": [
              "latitude"
            ],
            "osm_id": [
              "osm_type"
            ],
            "osm_type": [
              "osm_id"
            ]
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "geo_precision": {
                    "enum": [
                      "point",
                      "building"
                    ]
                  }
                },
                "required": [
                  "geo_precision"
                ]
              },
              "then": {
                "required": [
                  "latitude",
                  "longitude"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "geo_precision": {
                    "const": "unlocated"
                  }
                },
                "required": [
                  "geo_precision"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "latitude"
                      ]
                    },
                    {
                      "required": [
                        "longitude"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "summary_original",
                  "source_ids"
                ],
                "properties": {
                  "summary_original": {
                    "pattern": "\\S"
                  },
                  "source_ids": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "work": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "title",
            "author_ids"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "author_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,79}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "reading_book_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "openlibrary_work_id": {
              "type": "string",
              "pattern": "^OL[0-9]+W$"
            },
            "wikidata_qid": {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            },
            "original_language": {
              "type": "string"
            },
            "series_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "author": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "openlibrary_author_id": {
              "type": "string",
              "pattern": "^OL[0-9]+A$"
            },
            "wikidata_qid": {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            },
            "official_url": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "adaptation": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "title",
            "media_type",
            "original_work_id"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "media_type": {
              "enum": [
                "film",
                "series",
                "other"
              ]
            },
            "original_work_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "wikidata_qid": {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "title",
        "publisher",
        "retrieved_at",
        "source_kind",
        "evidence_summary",
        "license_review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "source_kind": {
          "enum": [
            "original_text",
            "author_statement",
            "cultural_institution",
            "tourism_official",
            "wikidata_statement",
            "osm_record",
            "open_library",
            "academic",
            "other",
            "overture_record",
            "geonames_record",
            "whg_record"
          ]
        },
        "evidence_summary": {
          "type": "string",
          "minLength": 1
        },
        "license_review": {
          "enum": [
            "not_required_for_link",
            "pending",
            "approved_for_copy",
            "restricted"
          ]
        },
        "dataset_license_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "attribution_text": {
          "type": "string"
        },
        "provider_release": {
          "type": "string",
          "maxLength": 70
        },
        "provider_record_id": {
          "type": "string",
          "maxLength": 140
        },
        "license_name": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "place_id",
        "subject_type",
        "subject_id",
        "relationship_type",
        "source_ids",
        "status",
        "evidence_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "place_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "subject_type": {
          "enum": [
            "work",
            "author",
            "adaptation"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "relationship_type": {
          "enum": [
            "narrative_explicit",
            "inspiration_documented",
            "filming_location",
            "author_public_history",
            "literary_homage",
            "popular_claim_unverified"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,79}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "candidate",
            "researching",
            "reviewed",
            "approved",
            "rejected",
            "retired"
          ]
        },
        "evidence_note": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "chapter_reference": {
          "type": "string"
        },
        "character_name": {
          "type": "string"
        },
        "narrative_order": {
          "type": "integer",
          "minimum": 1
        },
        "spoiler": {
          "type": "boolean"
        },
        "reviewer_note_private": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "verified_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "relationship_type": {
                "not": {
                  "const": "popular_claim_unverified"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "narrative_explicit"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "inspiration_documented"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "filming_location"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "adaptation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "author_public_history"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "author"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "literary_homage"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "work"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "popular_claim_unverified"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "subject_type": {
                "const": "work"
              }
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "place_id",
        "source_url",
        "license",
        "license_url",
        "attribution",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "place_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,79}$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "local_path": {
          "type": "string",
          "pattern": "^/assets/atlas/[a-zA-Z0-9/_-]+\\.(?:webp|jpg|png)$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "approved",
            "rejected"
          ]
        },
        "alt_original": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "route": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "slug",
            "title",
            "destination_id",
            "place_ids"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "destination_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,79}$"
            },
            "place_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,79}$"
              },
              "minItems": 2,
              "uniqueItems": true
            },
            "summary_original": {
              "type": "string"
            },
            "spoiler": {
              "type": "boolean"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
